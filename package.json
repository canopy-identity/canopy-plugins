{
  "name": "@canopy-io/plugins",
  "private": true,
  "description": "Canopy's plugins for Claude Code.",
  "license": "MIT",
  "author": "Canopy Identity Inc.",
  "homepage": "https://github.com/canopy-identity/canopy-plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canopy-identity/canopy-plugins.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "check:skill": "node scripts/check-skill-snippets.mjs",
    "check:release": "node scripts/check-release.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run check:release && npm run check:skill && npm run check:account-tools && npm run check:hosted-css",
    "check:account-tools": "node scripts/check-account-tools.mjs",
    "check:hosted-css": "node scripts/check-hosted-css.mjs"
  },
  "volta": {
    "node": "24.22.0",
    "npm": "11.19.1"
  },
  "devDependencies": {
    "@angular/common": "21.2.26",
    "@angular/core": "21.2.26",
    "@angular/router": "21.2.26",
    "@canopy-io/angular": "0.1.0",
    "@canopy-io/browser": "0.5.0",
    "@canopy-io/nestjs": "0.9.5",
    "@canopy-io/nextjs": "0.1.0",
    "@canopy-io/node": "0.26.2",
    "@canopy-io/react": "0.1.0",
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "husky": "9.1.7",
    "next": "16.4.6",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3"
  }
}
